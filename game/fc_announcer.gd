class_name FcAnnouncer
extends RefCounted
## The arena announcer: which spoken line a kill, a streak, a round or a match end earns, and when
## it may play. Pure logic with an injected clock so it is testable without audio; the presentation
## feeds it events and plays what [method next_line] returns.
##
## Every line has a threshold setting, 0 = off (no cap anywhere). Lines never overlap: one plays at
## a time, a gap follows it, and a line that waited longer than [member stale_sec] is dropped rather
## than announced late. The recordings are generated by tools/make_ui_audio.py.

## Line id -> [default threshold, priority (higher wins a tie)].
## Thresholds: kills inside the multi-kill window for the multi lines, the unbroken streak for the
## streak lines, 1 = on / 0 = off for the event lines.
const LINES := {
	&"monster_kill": [6, 90],
	&"ultra_kill": [5, 85],
	&"mega_kill": [4, 80],
	&"multi_kill": [3, 75],
	&"double_kill": [2, 70],
	&"godlike": [25, 100],
	&"unstoppable": [20, 98],
	&"dominating": [15, 96],
	&"rampage": [10, 94],
	&"killing_spree": [5, 92],
	&"first_blood": [1, 60],
	&"headshot": [1, 50],
	&"humiliation": [1, 55],
	&"flawless_victory": [1, 110],
	&"prepare_to_fight": [1, 65],
	&"last_man_standing": [1, 105],
}
const MULTI_LINES: Array[StringName] = [&"double_kill", &"multi_kill", &"mega_kill", &"ultra_kill", &"monster_kill"]
const STREAK_LINES: Array[StringName] = [&"killing_spree", &"rampage", &"dominating", &"unstoppable", &"godlike"]
const SOUND_PREFIX := "announce_"
## What a spoken line takes to say, seconds; the recordings are all under this.
const LINE_SEC := 1.1

## Seconds of silence after a line; 0 = lines may follow at once (they still never overlap).
var gap_sec := 0.35
## A queued line older than this is dropped; 0 = never dropped.
var stale_sec := 3.0
## Kills this close together chain into the multi-kill lines.
var multi_window_sec := 4.0
## Line id -> threshold; 0 = off. Missing ids use the default.
var thresholds: Dictionary = {}

var _busy_until := 0.0
var _queue: Array = []  # [line, priority, queued_at]
var _multi_count := 0
var _last_kill := -1000.0
var _kills := 0
var _deaths := 0


static func sound_id(line: StringName) -> StringName:
	return StringName(SOUND_PREFIX + String(line))


func threshold(line: StringName) -> int:
	return int(thresholds.get(line, (LINES[line] as Array)[0]))


## The settings key of a line's threshold.
static func setting_key(line: StringName) -> StringName:
	return StringName("announce_" + String(line))


## Reads every line threshold, the gap and the stale time from [param settings] (a GSSettingsManager).
func apply_settings(settings: Object) -> void:
	for line: StringName in LINES:
		thresholds[line] = int(settings.call(&"get_value", setting_key(line)))
	gap_sec = float(settings.call(&"get_value", &"announce_gap"))
	stale_sec = float(settings.call(&"get_value", &"announce_stale"))


## You killed somebody at [param now]. [param streak] is your unbroken kill count including this one.
func on_own_kill(now: float, streak: int, headshot: bool, first_blood: bool, melee := false) -> void:
	_kills += 1
	_multi_count = _multi_count + 1 if now - _last_kill <= multi_window_sec else 1
	_last_kill = now
	var picked: StringName = &""
	var best := -1
	# A streak line fires on the kill that reaches its threshold exactly, as does a multi line.
	for i in range(STREAK_LINES.size()):
		var t := threshold(STREAK_LINES[i])
		if t > 0 and streak == t:
			picked = STREAK_LINES[i]
			best = int((LINES[picked] as Array)[1])
	for line in MULTI_LINES:
		var t := threshold(line)
		var pr := int((LINES[line] as Array)[1])
		if t > 0 and _multi_count == t and pr > best:
			picked = line
			best = pr
	if picked == &"":
		for line: StringName in [&"first_blood", &"humiliation", &"headshot"]:
			var on := (line == &"first_blood" and first_blood) or (line == &"humiliation" and melee) or (line == &"headshot" and headshot)
			var pr := int((LINES[line] as Array)[1])
			if on and threshold(line) > 0 and pr > best:
				picked = line
				best = pr
	if picked != &"":
		request(picked, now)


## You died: the streak and the multi-kill chain are over, and a flawless match is not.
func on_own_death() -> void:
	_deaths += 1
	_multi_count = 0


## A round or match phase began. [param live] a round starting, [param match_end] the match over.
func on_phase(now: float, live: bool, match_end: bool) -> void:
	if live:
		request(&"prepare_to_fight", now)
	if match_end:
		if _kills > 0 and _deaths == 0:
			request(&"flawless_victory", now)
		_kills = 0
		_deaths = 0


func request(line: StringName, now: float) -> void:
	if not LINES.has(line) or threshold(line) <= 0:
		return
	_queue.append([line, int((LINES[line] as Array)[1]), now])


## The line to play now, or &"" when none is waiting or one is still being said. Highest priority
## first, then the oldest; stale lines are dropped.
func next_line(now: float) -> StringName:
	if _queue.is_empty():
		return &""
	if stale_sec > 0.0:
		_queue = _queue.filter(func(e: Array) -> bool: return now - float(e[2]) <= stale_sec)
	if _queue.is_empty() or now < _busy_until:
		return &""
	var at := 0
	for i in range(1, _queue.size()):
		if int(_queue[i][1]) > int(_queue[at][1]):
			at = i
	var line: StringName = _queue[at][0]
	_queue.remove_at(at)
	_busy_until = now + LINE_SEC + gap_sec
	return line


func pending() -> int:
	return _queue.size()
