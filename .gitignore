# Godot 4
.godot/
/android/

# Every gs-* addon is a separate repository. For local development, symlink them:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# A shipped build copies them in instead.
/addons/gs_core
/addons/gs_profile
/addons/gs_profiler
/addons/gs_entity
# gs-net: native snapshot codec; without its library for this platform the GDScript path runs ("native snapshots unavailable").
# bootstrap fetches the release zip into addons/gs_net/native/bin and export copies it beside the exe (gs-bootstrap: bootstrap-natives).
# bootstrap-natives: gs-net v0.1.44 native/bin
/addons/gs_net
/addons/gs_server
/addons/gs_server_query
/addons/gs_combat
/addons/gs_loadout
/addons/gs_match
/addons/gs_ui
/addons/gs_input
/addons/gs_map
/addons/gs_leaderboard
/addons/gs_stats
/addons/gs_achievements
/addons/gs_vote
/addons/gs_replay
/addons/gs_props
/addons/gs_npc
/addons/gs_npc_ai
/addons/gs_npc_ai_director
/addons/gs_bot
/addons/gs_bot_record
/addons/gs_auth
/addons/gs_browser
/addons/gs_chat
/addons/gs_cloud
/addons/gs_moderation
/addons/gs_platform
/addons/gs_user
/addons/gs_user_avatar
/addons/gs_voice
/addons/gs_weapon

# The combat surf maps: the fc-surf-dm-maps repository, linked here by gs-bootstrap off
# the comment line below (copied, on Windows), at the path the `.import` markers in it were
# written against. Arena plays the ones whose manifest says
# "kind": "arena" (combat surf maps); a checkout without the link plays the three built-in
# maps, which is a supported state, not a broken one.
# bootstrap-link: fc-surf-dm-maps/maps
/maps/imported

# gs-cloud mounts packs here; headless_imported writes a fake one and deletes it.
/gs_cloud/
/dot_cloud/

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Screenshots are evidence for a review, not assets.
/screenshots/
/addons/gs_objective
/addons/gs_effects
/addons/gs_spectate
/addons/gs_settings
/addons/gs_menu
/addons/gs_mobile
/addons/gs_audio
/addons/gs_camera
/addons/gs_fx
/addons/gs_console
/addons/gs_peer_to_peer
/addons/gs_physics
/addons/gs_spawn
/addons/gs_player
/addons/gs_player_controller
/addons/gs_player_char
/addons/gs_animation
/addons/gs_save
/addons/gs_camera
/addons/gs_player_class
/addons/gs_team
/addons/gs_lighting
/addons/gs_flashlight
# fc-weapons: the game's whole weapon set (definitions and models), required.
/addons/fc_weapons
/addons/gs_game
# gs-sim: optional native library (movement motor, bot senses, snapshot codec); without its built library the GDScript twins run.
# bootstrap fetches this release's library for the machine (gs-bootstrap: bootstrap-natives); the log says "gs-sim: native ...".
# bootstrap-natives: gs-sim v0.2.28
/addons/gs_sim
/addons/gs_workbench
# Maps copied in by hand to play solo (see maps/fc_local_maps.gd). No leading slash: tools read "/addons/<name>" lines as addons to link.
addons/maps/
/lightbake_work/

# Generated
__pycache__/
/tests/golden/*.import

# Converted worlds (gs-map regen) of the combat surf maps, and the art stores they name: a link to fc-surf-dm-maps.
# bootstrap-link: fc-surf-dm-maps/worlds
/worlds

# Converted worlds of the deathmatch maps.
# bootstrap-link: fc-dm-maps/worlds
/worlds_dm

# The deathmatch and gun game maps: the fc-dm-maps repository, linked here beside the surf maps.
# bootstrap-link: fc-dm-maps/maps
/maps/imported_dm

# Git worktrees some sessions put inside the checkout.
/wt-*/
# Written by addons/gs_profiler/tools/build_stamp.sh for a build without .git.
/build_id.json

# Valve's own files: a player's Source game install is read LOCAL ONLY (game/fc_source_install.gd, cached in the user
# folder) and never enters the repository; headless_local_maps checks the project holds none.
*.vpk
*.vtf
*.vmt
*.mdl
textures/orig/

# Team bodies prepared from other people's art (fc_team_bodies.gd): kept out of the repository.
/private/
# fc-player-classes team bodies, fetched by content.lock.json (kind store).
/assets/team_bodies/

# Old boot screenshot dumps (no current tool writes here; kept out of the repo and packs)
/shots_boot/
/addons/gs_sql
/addons/godot-sqlite
