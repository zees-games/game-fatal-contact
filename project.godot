; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fatal Contact"
run/main_scene="res://game/fc.tscn"
config/features=PackedStringArray("4.7")
config/use_custom_user_dir=true
config/custom_user_dir_name="game-fatal-contact"
config/icon="res://branding/icon.png"
config/windows_native_icon="res://branding/icon.ico"
boot_splash/bg_color=Color(0.051, 0.0588, 0.0784, 1)
boot_splash/fullsize=true
boot_splash/image="res://branding/splash.png"
boot_splash/show_image=true
boot_splash/use_filter=true

[audio]

driver/enable_input=true

[importer_defaults]

texture={
"detect_3d/compress_to": 0
}

[editor_plugins]

enabled=PackedStringArray("res://addons/gs_lighting/plugin.cfg")

[physics]

common/physics_ticks_per_second=66

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/default_filters/anisotropic_filtering_level=4

[gamespice]

perf_game_id="fatal-contact"
